rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      allow get, write: if request.auth != null;
      match /entries/{key} {
        allow read, write: if request.auth != null;
      }
      match /sessions/{id} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
